[gd_resource type="ShaderMaterial" format=3 uid="uid://cchmdqcts2kvi"]

[ext_resource type="Texture2D" uid="uid://jq8i7t1j8nrd" path="res://01_HoudiniExports/finish_ribbon/finish_pos.exr" id="1_utsxd"]
[ext_resource type="Texture2D" uid="uid://coo0xfh4l0nk4" path="res://01_HoudiniExports/finish_ribbon/finish_rot.exr" id="2_til4c"]

[sub_resource type="Shader" id="Shader_utsxd"]
code = "shader_type spatial;
render_mode cull_disabled;

#define VAT3MODE_SOFTBODY

#include \"res://VAT3_GodotEngine/VAT3_Wraper.gdshaderinc\"

uniform vec4 base_color : source_color = vec4(0.2, 0.65, 1.0, 1.0);
uniform bool use_base_texture = false;
uniform sampler2D base_texture : source_color;

void vertex() {
	Vat3_Vertex_Input inputs;
	inputs.vertexPosition = VERTEX;
	inputs.texCoord0 = UV;
	inputs.texCoord1 = UV2;

	#if defined(VAT3MODE_RIGIDBODY)
		inputs.vertexNormal = NORMAL;
		inputs.vertexTangent = TANGENT;
		inputs.texCoord2 = CUSTOM0.xy;
		inputs.texCoord3 = CUSTOM0.zw;
	#endif

	Vat3_NonTexInputs settings = GetVat3Inputs(inputs);
	Vat3_Outputs result = ApplyVAT3_Deformation(inputs, settings);

	VERTEX = result.outPosition;
	NORMAL = result.outNormal;
	TANGENT = result.outTangent;
	UV = result.surfaceUv;
}

void fragment() {
	vec3 colour = base_color.rgb;

	if (use_base_texture) {
		colour *= texture(base_texture, UV).rgb;
	}

	ALBEDO = colour;
	ROUGHNESS = 0.45;
}"

[resource]
render_priority = 0
shader = SubResource("Shader_utsxd")
shader_parameter/_isTexHdr = true
shader_parameter/_boundMax = Vector3(11, 1.4, 7.15)
shader_parameter/_boundMin = Vector3(-11.1, -0.31300002, -7.1)
shader_parameter/_houdiniFPS = 24.0
shader_parameter/_frameCount = 800.0
shader_parameter/_surfaceNormals = false
shader_parameter/_interpolate = true
shader_parameter/_gameTimeAtFirstFrame = 0.0
shader_parameter/_playbackSpeed = 1.0
shader_parameter/_displayFrame = 1.0
shader_parameter/_autoPlayback = false
shader_parameter/vatPosTex = ExtResource("1_utsxd")
shader_parameter/vatRotTex = ExtResource("2_til4c")
shader_parameter/base_color = Color(1, 1, 1, 1)
shader_parameter/use_base_texture = false
